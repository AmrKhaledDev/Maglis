model Friendship {
    id        String   @id @default(cuid())
    userId    String
    friendId  String
    createdAt DateTime @default(now())

    user   User @relation("MyFriends", fields: [userId], references: [id], onDelete: Cascade)
    friend User @relation("FriendsOfMe", fields: [friendId], references: [id], onDelete: Cascade)

    @@unique([userId, friendId])
}